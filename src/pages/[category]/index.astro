---
import { env } from 'cloudflare:workers';
import { CATEGORIES } from '../../categories';
import ExploreView from '../../components/explore/ExploreView';
import { getExploreFeed, getExploreFilters } from '../../data/api';
import Layout from '../../layouts/Layout.astro';
import { SITE_NAME, SITE_ORIGIN } from '../../site';

const { category } = Astro.params;
if (!category || !Object.hasOwn(CATEGORIES, category)) {
  return new Response('Not found', { status: 404 });
}
const match = CATEGORIES[category]!;
const initialSearch = Astro.url.searchParams.get('q')?.trim() ?? '';
const ctx = Astro.locals.cfContext;
const [initialData, initialFilters] = await Promise.all([
  getExploreFeed(initialSearch ? { category, q: initialSearch } : { category }, env, ctx),
  getExploreFilters(category, env, ctx),
]);
// Both the <head> autodiscovery link and the strip's "+ feed" CTA point at
// this category's feed.
const feedPath = `/${category}/rss.xml`;
const categoryUrl = `${SITE_ORIGIN}/${category}`;
const description = `Latest ${match.label} links from the curated explore feed.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${match.label} Links`,
    description,
    url: categoryUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE_ORIGIN,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: match.label,
        item: categoryUrl,
      },
    ],
  },
];
---
<Layout
  title={`${SITE_NAME} — ${match.label} links`}
  description={description}
  feedPath={feedPath}
  feedTitle={`${SITE_NAME} — ${match.label} links`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main>
    <ExploreView
      initialData={initialData}
      initialFilters={initialFilters}
      initialCategory={category}
      initialSearch={initialSearch}
      client:load
    />
  </main>
</Layout>
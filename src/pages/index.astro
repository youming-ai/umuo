---
import { env } from 'cloudflare:workers';
import DeskStats from '../components/DeskStats.astro';
import ExploreView from '../components/explore/ExploreView';
import { getDeskStats, getExploreFeed, getExploreFilters } from '../data/api';
import Layout from '../layouts/Layout.astro';

const ctx = Astro.locals.cfContext;
const [initialData, initialFilters, deskStats] = await Promise.all([
  getExploreFeed({}, env, ctx),
  getExploreFilters('', env, ctx),
  getDeskStats(env, ctx),
]);
---
<Layout title="umuo — AI football news">
  <main>
    <DeskStats stats={deskStats} />
    <ExploreView initialData={initialData} initialFilters={initialFilters} client:load />
  </main>
</Layout>


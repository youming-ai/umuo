---
import { env } from 'cloudflare:workers';
import ExploreView from '../components/explore/ExploreView';
import { getExploreFeed, getExploreFilters } from '../data/api';
import { SITE_DESCRIPTION, SITE_NAME, SITE_ORIGIN, SITE_TITLE } from '../site';
import Layout from '../layouts/Layout.astro';

const ctx = Astro.locals.cfContext;
const [initialData, initialFilters] = await Promise.all([
  getExploreFeed({}, env, ctx),
  getExploreFilters('', env, ctx),
]);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: 'umuo football news',
  url: SITE_ORIGIN,
  description: SITE_DESCRIPTION,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_ORIGIN}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<Layout title={SITE_TITLE}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <main>
    <h1 class="sr-only">umuo — AI-Curated Football News Desk</h1>
    <ExploreView initialData={initialData} initialFilters={initialFilters} client:load />
  </main>
</Layout>

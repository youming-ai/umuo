---
import { env } from 'cloudflare:workers';
import { COMPETITIONS } from '../../competitions';
import LeftNav from '../../components/LeftNav.astro';
import OddsIsland from '../../components/OddsIsland';
import RightRailIsland from '../../components/RightRailIsland';
import { getCompetitionView } from '../../data/api';
import Layout from '../../layouts/Layout.astro';

const { comp } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
// Capability gate: only competitions whose scoreboard feed carries betting
// lines expose the Odds tab. Others 307 back to the competition root.
if (!competition.capabilities.odds) {
  return Astro.redirect(`/${comp}`, 307);
}
const ctx = Astro.locals.cfContext;
const initialData = await getCompetitionView(competition, env, ctx);
---
<Layout title={`umuo — ${competition.label} Odds`}>
  <LeftNav slot="left" comp={comp} active="odds" />
  <main>
    <h1 class="mb-card font-display text-hero font-bold tracking-wide text-chalk">
      {competition.label} Odds
    </h1>
    <OddsIsland comp={comp} initialData={initialData} client:load />
  </main>
  <RightRailIsland slot="right" comp={comp} initialData={initialData} client:load />
</Layout>

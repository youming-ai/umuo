---
import { env } from 'cloudflare:workers';
import { COMPETITIONS } from '../../../competitions';
import LeftNav from '../../../components/LeftNav.astro';
import MatchDetailIsland from '../../../components/MatchDetailIsland';
import { getCompMatchBySlug, getMatchSummary } from '../../../data/api';
import Layout from '../../../layouts/Layout.astro';

const { comp, slug } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
const ctx = Astro.locals.cfContext;
const match = await getCompMatchBySlug(competition, slug!, env, ctx);
if (!match) Astro.response.status = 404;
const initialDetail = match ? await getMatchSummary(competition, match.id, env, ctx) : null;

// client:only islands do not hydrate pre-rendered siblings — an SSR hero here
// would permanently stack under the React hero. The island owns the full
// match detail (back, live scoreboard, tabs) and seeds from SSR data.
---

<Layout title={`umuo — ${match ? `${match.homeName} vs ${match.awayName}` : 'Match'}`}>
  <LeftNav slot="left" comp={comp} />
  <main>
    {match ? (
      <MatchDetailIsland match={match} initialDetail={initialDetail} client:only="react" />
    ) : (
      <p class="p-card text-center font-mono text-xs text-chalkdim">Match not found</p>
    )}
  </main>
</Layout>

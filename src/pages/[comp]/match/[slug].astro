---
import { env } from 'cloudflare:workers';
import { COMPETITIONS } from '../../../competitions';
import LeftNav from '../../../components/LeftNav.astro';
import MatchDetailIsland from '../../../components/MatchDetailIsland';
import { getCompMatchBySlug, getMatchSummary } from '../../../data/api';
import Layout from '../../../layouts/Layout.astro';

const { comp, slug } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
const ctx = Astro.locals.cfContext;
// 404 only for a slug the scoreboard genuinely doesn't have; an upstream
// outage throws and answers 503 so a valid match URL never looks permanently
// gone to users or crawlers.
let match: Awaited<ReturnType<typeof getCompMatchBySlug>> = null;
let unavailable = false;
try {
  match = await getCompMatchBySlug(competition, slug!, env, ctx);
} catch {
  unavailable = true;
}
if (!match) Astro.response.status = unavailable ? 503 : 404;
const initialDetail = match ? await getMatchSummary(competition, match.id, env, ctx) : null;

// The island owns the full match detail (back, hero, tabs) and renders on the
// server too (client:load), so the markup is in the document before hydration.
---

<Layout title={`umuo — ${match ? `${match.homeName} vs ${match.awayName}` : 'Match'}`}>
  <LeftNav slot="left" comp={comp} />
  <main>
    {match ? (
      <MatchDetailIsland comp={comp} match={match} initialDetail={initialDetail} client:load />
    ) : (
      <p class="p-card text-center font-mono text-xs text-chalkdim">
        {unavailable ? 'Match data is temporarily unavailable' : 'Match not found'}
      </p>
    )}
  </main>
</Layout>

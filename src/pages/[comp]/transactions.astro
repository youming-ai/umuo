---
import { COMPETITIONS } from '../../competitions';
import LeftNav from '../../components/LeftNav.astro';
import RightRailIsland from '../../components/RightRailIsland';
import MovesIsland from '../../components/MovesIsland';
import { getCompetitionView, getLeagueInjuries, getTransactions } from '../../data/api';
import Layout from '../../layouts/Layout.astro';

const { comp } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
// Capability gate: only NBA (or future US sports) exposes the transactions feed.
if (!competition.capabilities.transactions) {
  return Astro.redirect(`/${comp}`, 307);
}
const env = Astro.locals.runtime.env;
const ctx = Astro.locals.runtime.ctx as Parameters<typeof getTransactions>[2];
const [transactions, injuries, initialData] = await Promise.all([
  getTransactions(competition, env, ctx),
  getLeagueInjuries(competition, env, ctx),
  getCompetitionView(competition, env, ctx),
]);
---
<Layout title={`umuo — ${competition.label} Roster Moves`} comp={comp}>
  <LeftNav slot="left" comp={comp} active="transactions" />
  <main>
    <h1 class="mb-card font-display text-2xl font-bold tracking-wide text-chalk">
      {competition.label} Roster Moves
    </h1>
    <MovesIsland transactions={transactions} injuries={injuries} client:only="react" />
  </main>
  <RightRailIsland slot="right" comp={comp} initialData={initialData} client:only="react" />
</Layout>

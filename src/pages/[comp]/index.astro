---
import { env } from 'cloudflare:workers';
import { FOOTBALL_COMPETITIONS } from '../../competitions';
import ExploreView from '../../components/explore/ExploreView';
import { getExploreFeed, getExploreFilters } from '../../data/api';
import { SITE_NAME, SITE_ORIGIN } from '../../site';
import Layout from '../../layouts/Layout.astro';

const { comp } = Astro.params;
if (!comp || !Object.hasOwn(FOOTBALL_COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = FOOTBALL_COMPETITIONS[comp]!;
const ctx = Astro.locals.cfContext;
const [initialData, initialFilters] = await Promise.all([
  getExploreFeed({ comp }, env, ctx),
  getExploreFilters(comp, env, ctx),
]);
// Both the <head> autodiscovery link and the strip's "+ feed" CTA point at
// this league's feed.
const feedPath = `/${comp}/rss.xml`;
const compUrl = `${SITE_ORIGIN}/${comp}`;
const description = `Latest ${competition.label} football news, transfer updates, and match analysis curated by AI.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${competition.label} Football News`,
    description,
    url: compUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE_ORIGIN,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: competition.label,
        item: compUrl,
      },
    ],
  },
];
---
<Layout
  title={`${SITE_NAME} — ${competition.label} football news`}
  description={description}
  feedPath={feedPath}
  feedTitle={`${SITE_NAME} — ${competition.label} football news`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main>
    <h1 class="sr-only">{competition.label} Football News — umuo</h1>
    <ExploreView
      initialData={initialData}
      initialFilters={initialFilters}
      initialComp={comp}
      client:load
    />
  </main>
</Layout>

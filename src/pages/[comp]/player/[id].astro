---
import { env } from 'cloudflare:workers';
import { COMPETITIONS } from '../../../competitions';
import LeftNav from '../../../components/LeftNav.astro';
import PlayerPageIsland from '../../../components/PlayerPageIsland';
import RightRailIsland from '../../../components/RightRailIsland';
import { getCompetitionView } from '../../../data/api';
import Layout from '../../../layouts/Layout.astro';

const { comp, id } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
if (!id) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
const ctx = Astro.locals.cfContext;
const view = await getCompetitionView(competition, env, ctx);

// ponytail: no 404 when the athlete isn't in `scorers` — that list is only the
// top-15 leaderboard, so absence proves nothing about the player, and a
// standings/leaders outage proves even less. The island still renders their
// goals from the scoreboard. Upgrade path: a real per-athlete lookup, which is
// the only thing that could justify a 404 here.
const scorer = view.scorers.find((s) => s.athleteId === id);
const playerName = scorer?.name ?? 'Player';
---

<Layout title={`umuo — ${playerName}`}>
  <LeftNav slot="left" comp={comp} />
  <main>
    <div class="space-y-section">

      <div>
        <h1 class="font-display font-bold text-3xl text-chalk tracking-wide">
          {playerName}
        </h1>
        {scorer && (
          <div class="flex items-center gap-3 mt-1">
            {scorer.teamName && (
              <span class="font-mono text-label uppercase tracking-caption text-chalkdim">
                {scorer.teamName}
              </span>
            )}
            <span class="font-mono text-label text-chalkdim">
              {scorer.goals} goals
            </span>
          </div>
        )}
      </div>

      <!-- Island: takes over for goals timeline, team nav link, back button, stats -->
      <PlayerPageIsland
        comp={comp}
        athleteId={id}
        groups={view.standings.kind === 'soccer' ? view.standings.groups : []}
        matches={view.matches}
        scorers={view.scorers}
        client:load
      />

    </div>
  </main>
  <RightRailIsland slot="right" comp={comp} initialData={view} client:load />
</Layout>

---
import { env } from 'cloudflare:workers';
import { COMPETITIONS } from '../../competitions';
import LeftNav from '../../components/LeftNav.astro';
import RightRailIsland from '../../components/RightRailIsland';
import TeamsView from '../../components/TeamsView';
import { getCompetitionView, getTeams } from '../../data/api';
import Layout from '../../layouts/Layout.astro';

const { comp } = Astro.params;
if (!comp || !Object.hasOwn(COMPETITIONS, comp)) {
  return new Response('Not found', { status: 404 });
}
const competition = COMPETITIONS[comp]!;
const ctx = Astro.locals.cfContext;
const [teams, initialData] = await Promise.all([
  getTeams(competition, env, ctx),
  getCompetitionView(competition, env, ctx),
]);
---
<Layout title={`umuo — ${competition.label} Teams`}>
  <LeftNav slot="left" comp={comp} active="teams" />
  <main>
    <h1 class="mb-card font-display text-hero font-bold tracking-wide text-chalk">
      {competition.label} Teams
    </h1>
    <TeamsView comp={comp} teams={teams} client:load />
  </main>
  <RightRailIsland slot="right" comp={comp} initialData={initialData} client:load />
</Layout>

---
import { env } from 'cloudflare:workers';
import { CATEGORIES } from '../../categories';
import { getArticle, getRelatedArticles } from '../../data/api';
import Layout from '../../layouts/Layout.astro';
import { GLOBAL_FEED_LABEL, SITE_NAME, SITE_ORIGIN, articleDeck, articlePath } from '../../site';

export const prerender = false;

const { id } = Astro.params;
if (!id) return new Response('Not found', { status: 404 });

const article = await getArticle(id, env, Astro.locals.cfContext as ExecutionContext);
if (!article) return new Response('Not found', { status: 404 });

const relatedArticles = await getRelatedArticles(
  article,
  env,
  Astro.locals.cfContext as ExecutionContext,
  4,
);

const category = article.category ? CATEGORIES[article.category] : null;
const backHref = category ? `/${article.category}` : '/';
const backLabel = category?.label ?? GLOBAL_FEED_LABEL;
const summary = articleDeck(article, 'long');
const blurb = article.blurb && article.blurb !== summary ? article.blurb : null;
const domain = article.sourceDomain || article.sourceName || 'tech source';
const pubDate = new Date(article.publishedAt);
const pubIso = pubDate.toISOString();
const pubDisplay = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const articleType = article.articleType.replaceAll('-', ' ');
const selfUrl = `${SITE_ORIGIN}${articlePath(article.id)}`;

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: SITE_ORIGIN,
  },
];
if (category) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: category.label,
    item: `${SITE_ORIGIN}/${category.key}`,
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: breadcrumbItems.length + 1,
  name: article.title,
  item: selfUrl,
});

// NewsArticle & BreadcrumbList structured data. The AI summary is the page's own content;
// the original source is attributed via `isBasedOn` + the visible outbound link.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: article.title,
    description: summary,
    datePublished: pubIso,
    dateModified: pubIso,
    author: { '@type': 'Organization', name: SITE_NAME },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: SITE_ORIGIN,
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': selfUrl },
    url: selfUrl,
    articleSection: category?.label ?? 'Tech',
    ...(article.tags.length > 0 ? { keywords: article.tags.join(', ') } : {}),
    ...(article.imageUrl ? { image: article.imageUrl } : {}),
    isBasedOn: article.url,
    creditText: article.sourceName || domain,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];

function formatCardDate(timestamp: number): string {
  if (!Number.isFinite(timestamp) || timestamp <= 0) return '';
  const d = new Date(timestamp);
  return `${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}`;
}

const ogImageUrl = article.imageUrl ?? undefined;
---
<Layout
  title={`${article.title} — ${SITE_NAME}`}
  description={summary}
  ogType="article"
  image={ogImageUrl}
  imageAlt={article.imageUrl ? article.title : undefined}
>
  {/* set:html is raw and JSON.stringify does not escape `<`, so a headline
      carrying `</script>` (rss.ts decodes &lt; back to <) would break out of
      this element. Escaping the one character that can close the tag is enough. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />
  <main class="mx-auto max-w-2xl px-4 py-6 sm:py-10">
    <nav class="mb-6 flex items-center justify-between">
      <a
        href={backHref}
        class="inline-flex items-center gap-1.5 ds-caption text-chalkdim transition-colors hover:text-pitch"
      >
        <span aria-hidden="true">←</span> {backLabel}
      </a>
      {category && (
        <a
          href={`/${category.key}`}
          class="ds-caption rounded-pill border border-line/40 px-2.5 py-0.5 text-chalkdim transition-colors hover:border-pitch/40 hover:text-pitch"
        >
          {category.label}
        </a>
      )}
    </nav>

    <div class="flex flex-wrap items-center gap-2 ds-caption text-pitch">
      <span aria-hidden="true">&gt;_</span>
      <span class="font-semibold">{domain}</span>
      <span class="text-chalkdim">·</span>
      <time datetime={pubIso} class="text-chalkdim">{pubDisplay}</time>
      {articleType !== 'news' && (
        <>
          <span class="text-chalkdim">·</span>
          <span class="uppercase tracking-data text-chalkdim">{articleType}</span>
        </>
      )}
    </div>

    <h1 class="mt-3 font-display text-2xl font-bold leading-tight text-chalk sm:text-3xl lg:text-4xl">
      {article.title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-3 ds-caption text-chalkdim">
      <span class="inline-flex items-center gap-1 rounded-pill bg-overlay/10 px-2.5 py-1">
        AI Quality: <span class="font-semibold text-chalk">{article.qualityScore}</span>/100
      </span>
      <span class="inline-flex items-center gap-1 rounded-pill bg-overlay/10 px-2.5 py-1">
        Freshness: <span class="font-semibold text-chalk">{article.freshnessScore}</span>/100
      </span>
    </div>

    {article.imageUrl && (
      <div class="mt-6 overflow-hidden rounded-card border border-line/40 bg-overlay/5">
        <img
          src={article.imageUrl}
          alt={article.title}
          class="w-full object-cover"
          loading="eager"
          style={
            article.imageWidth > 0 && article.imageHeight > 0
              ? { aspectRatio: `${article.imageWidth} / ${article.imageHeight}` }
              : undefined
          }
        />
      </div>
    )}

    {blurb && (
      <div class="mt-6 rounded-card border border-pitch/30 bg-pitch/5 p-4 text-chalk">
        <div class="mb-1 flex items-center gap-1.5 ds-caption font-semibold uppercase tracking-data text-pitch">
          <span aria-hidden="true">&gt;_</span> Key Takeaway
        </div>
        <p class="ds-body text-chalk leading-relaxed">{blurb}</p>
      </div>
    )}

    {summary && (
      <div class="mt-6">
        <div class="mb-2 flex items-center gap-1.5 ds-caption font-semibold uppercase tracking-data text-pitch">
          <span aria-hidden="true">&gt;_</span> AI Summary & Analysis
        </div>
        <div class="ds-body text-chalk leading-relaxed whitespace-pre-line text-base sm:text-lg">
          {summary}
        </div>
      </div>
    )}

    <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-card border border-line/40 bg-panel/70 p-4">
      <div>
        <div class="ds-caption text-chalkdim">Original Source Coverage</div>
        <div class="font-semibold text-chalk">{domain}</div>
      </div>
      <a
        href={article.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-card bg-pitch px-5 py-2.5 font-display font-bold text-ink transition-opacity hover:opacity-90"
      >
        Read original story at {domain} <span aria-hidden="true">↗</span>
      </a>
    </div>

    {article.tags.length > 0 && (
      <div class="mt-8">
        <div class="mb-2 ds-caption text-chalkdim">Related Topics:</div>
        <div class="flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <span class="ds-caption rounded-pill bg-overlay/10 px-2.5 py-1 text-chalkdim transition-colors hover:text-pitch">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    {relatedArticles.length > 0 && (
      <section class="mt-12 border-t border-line/40 pt-8">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="font-display text-xl font-bold text-chalk">
            Related Tech News
          </h2>
          <span class="ds-caption text-pitch">AI Curated</span>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {relatedArticles.map((rel) => (
            <a
              href={articlePath(rel.id)}
              class="group flex flex-col justify-between rounded-card border border-line/40 bg-panel/70 p-3.5 transition-all hover:border-pitch/50 hover:bg-overlay/5"
            >
              <div>
                <div class="flex items-center justify-between ds-caption text-chalkdim">
                  <span class="truncate text-pitch">{rel.sourceDomain || rel.sourceName}</span>
                  <span class="shrink-0 tabular-nums">{formatCardDate(rel.publishedAt)}</span>
                </div>
                <h3 class="mt-1.5 font-display text-base font-bold leading-snug text-chalk transition-colors group-hover:text-pitch line-clamp-2">
                  {rel.title}
                </h3>
                <p class="mt-1 ds-body text-xs text-chalkdim line-clamp-2">
                  {articleDeck(rel, 'short')}
                </p>
              </div>
              <div class="mt-3 flex items-center justify-between ds-caption text-chalkdim">
                <span class="uppercase tracking-data text-[10px] text-pitch">
                  {rel.articleType.replaceAll('-', ' ')}
                </span>
                <span class="text-xs transition-transform group-hover:translate-x-0.5 text-pitch">
                  Read summary →
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

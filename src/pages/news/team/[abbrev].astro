---
import NewsIsland from '../../../components/NewsIsland';
import NewsRightRailIsland from '../../../components/NewsRightRailIsland';
import { fetchNewsItems } from '../../../data/api';
import Layout from '../../../layouts/Layout.astro';
import type { NewsScope } from '../../../types';

const team = Astro.params.abbrev ?? '';
const scope: NewsScope = { by: 'team', team };
const env = Astro.locals.runtime.env;
const ctx = Astro.locals.runtime.ctx as Parameters<typeof fetchNewsItems>[2];
const items = await fetchNewsItems({ limit: 20, team }, env, ctx);
---
<Layout title={`umuo — News — ${team.toUpperCase()}`}>
  <main>
    <NewsIsland scope={scope} initialData={items} client:only="react" />
  </main>
  <NewsRightRailIsland slot="right" client:only="react" />
</Layout>

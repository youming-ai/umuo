---
import '../index.css';
import Footer from '../components/Footer.astro';
import {
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_LOCALE,
  SITE_NAME,
  SITE_ORIGIN,
  SITE_TITLE,
} from '../site';

interface Props {
  title?: string;
  description?: string;
  /** RSS surface this page is the web twin of — `/rss.xml` globally,
   *  `/<comp>/rss.xml` on a league hub. */
  feedPath?: string;
  feedTitle?: string;
  /** Open Graph object type. `article` on /a/{id} detail pages. */
  ogType?: 'website' | 'article';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  feedPath = '/rss.xml',
  feedTitle = SITE_TITLE,
  ogType = 'website',
} = Astro.props;

// Strip a trailing slash from the path so canonical/og:url match the actual page.
const rawPath = Astro.url.pathname;
const canonicalPath =
  rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath || '/';
const canonicalUrl = `${SITE_ORIGIN}${canonicalPath}`;
---
<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="yandex-verification" content="89049dae4e3baef2" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feedTitle}
      href={`${SITE_ORIGIN}${feedPath}`}
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded weights: Saira Condensed 600/700, Hanken Grotesk 400.
         Keep this URL in sync with usage. -->
    <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Hanken+Grotesk:wght@400&display=swap" rel="stylesheet" />
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y11ve9ayn3");
    </script>
  </head>
  <body class="min-h-screen">
    <script is:inline>
      // Read theme before paint so the first frame already carries the right chrome.
      (() => {
        try {
          const t = localStorage.getItem('theme');
          const theme = t === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (_e) {
          document.documentElement.dataset.theme = 'dark';
        }

        const syncThemeColor = () => {
          const channels = getComputedStyle(document.documentElement)
            .getPropertyValue('--c-bg')
            .trim();
          if (channels) {
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute('content', `rgb(${channels})`);
          }
        };
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
    <div class="relative z-10 flex flex-col min-h-screen">
      <div class="flex-1 w-full">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

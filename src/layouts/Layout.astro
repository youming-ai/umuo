---
import '../index.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker';
import { SITE_ORIGIN } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Hide the sticky global Ticker strip. Used on the home page where the
      page itself owns the richer scoreboard band. */
  showTicker?: boolean;
  /** Hide the global Header row. The Explore pages carry the wordmark and the
      theme switcher inside their own toolbar, so a second near-empty sticky
      bar above it is pure chrome. */
  showHeader?: boolean;
}

const {
  title = 'umuo — AI football news',
  description = 'AI-curated football news from trusted sources, organized by competition and topic.',
  showTicker = true,
  showHeader = true,
} = Astro.props;

// Rails are opt-in per page via named slots. When a page has rails, the shell
// owns the width + page padding and lays out the 3-col grid. When it has none,
// the shell adds nothing — the page's own content wrapper keeps its width and
// padding (so existing pages need no change and never double-pad).
const hasLeft = Astro.slots.has('left');
const hasRight = Astro.slots.has('right');
const hasRails = hasLeft || hasRight;
const cols =
  hasLeft && hasRight
    ? 'lg:grid lg:gap-6 lg:grid-cols-[13rem_minmax(0,1fr)_20rem]'
    : hasRight
      ? 'lg:grid lg:gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]'
      : 'lg:grid lg:gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]';
const frame = hasRails ? `mx-auto max-w-6xl px-page-x md:px-page-x-md py-page-y ${cols}` : '';

// --h-topbar (ticker + header) is the shared sticky-offset token, but it
// assumes both rows are present. Pages that hide either must narrow it so
// sticky rails don't float below the actual bar.
const topbarStyle =
  showTicker && showHeader
    ? undefined
    : `--h-topbar: ${showTicker ? 'var(--h-ticker)' : showHeader ? 'var(--h-header)' : '0px'}`;

// Canonical + og:url must match the actual page path (not a hardcoded /news).
// Use the production origin so previews/dev still emit stable share URLs.
const rawPath = Astro.url.pathname;
const canonicalPath =
  rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath || '/';
const canonicalUrl = `${SITE_ORIGIN}${canonicalPath}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="umuo" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="umuo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE_ORIGIN}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:locale:alternate" content="ja_JP" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_ORIGIN}/og.jpg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded weights are the contract: Saira Condensed 600/700 (display:
         use font-semibold/bold — font-black is NOT loaded), Hanken Grotesk
         400 (body: no heavier weights). Keep this URL in sync with usage. -->
    <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Hanken+Grotesk:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen">
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          const theme = t === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (_e) {
          document.documentElement.dataset.theme = 'dark';
        }

        const syncThemeColor = () => {
          const channels = getComputedStyle(document.documentElement)
            .getPropertyValue('--c-bg')
            .trim();
          if (channels) {
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute('content', `rgb(${channels})`);
          }
        };
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
    <script is:inline>
      // PWA service worker — production only (localhost/dev keeps network free).
      (() => {
        const host = location.hostname;
        const isLocal = host === 'localhost' || host === '127.0.0.1' || host === '::1';
        if (isLocal || !('serviceWorker' in navigator)) return;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      })();
    </script>
    <div class="relative z-10 flex flex-col min-h-screen" style={topbarStyle}>
      {(showTicker || showHeader) && (
        <div class="sticky top-0 z-40 bg-night/95 backdrop-blur-md">
          {/* Reserve the ticker's row height so the client:only strip fills it on
              hydration instead of popping in and shoving the header down (CLS).
              Height is the shared `--h-ticker` token (see index.css) so the
              reserve and every sticky offset below the bar stay in sync. */}
          {showTicker ? (
            <div class="min-h-[var(--h-ticker)]">
              <Ticker client:only="react" />
            </div>
          ) : null}
          {showHeader ? <Header /> : null}
        </div>
      )}
      <div class={`flex-1 w-full ${frame}`}>
        {hasLeft && (
          <aside class="mb-4 lg:mb-0 lg:self-start lg:sticky lg:top-[var(--h-topbar)] lg:max-h-[calc(100vh-var(--h-topbar))] lg:overflow-y-auto no-scrollbar">
            <slot name="left" />
          </aside>
        )}
        <div class="min-w-0">
          <slot />
        </div>
        {hasRight && (
          <aside class="mt-4 lg:mt-0 lg:self-start lg:sticky lg:top-[var(--h-topbar)] lg:max-h-[calc(100vh-var(--h-topbar))] lg:overflow-y-auto no-scrollbar">
            <slot name="right" />
          </aside>
        )}
      </div>
      <Footer />
    </div>
  </body>
</html>

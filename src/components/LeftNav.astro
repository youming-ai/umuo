---
import { COMPETITIONS } from '../competitions';
import { SECTIONS } from '../sections';
import { pathFor, type Section } from '../utils/router';

interface Props {
  comp: string;
  active?: Section; // omitted on team/player/match pages → nothing highlighted
}
const { comp, active } = Astro.props;
const caps = COMPETITIONS[comp]?.capabilities;

// The new product is news-only. Keep the full SECTIONS registry for legacy
// routes/sitemap compatibility, but expose only the news hub in the live nav.
const items = SECTIONS.filter(
  (s) => s.section === 'news' && (!s.capability || caps?.[s.capability]),
).map((s) => ({
  section: s.section,
  label: s.label,
  href: pathFor({ kind: 'section', comp, section: s.section }),
}));
---
<div class="flex flex-col gap-4 lg:sticky lg:top-[var(--h-topbar)]">
  <nav
    aria-label="Sections"
    class="flex gap-1 overflow-x-auto no-scrollbar lg:flex-col lg:overflow-visible"
  >
    {items.map((it) => (
      <a
        href={it.href}
        aria-current={active === it.section ? 'page' : undefined}
        class={`shrink-0 whitespace-nowrap rounded-card px-3 py-2 font-display text-sm tracking-wide ds-press ${
          active === it.section
            ? 'bg-overlay/10 text-chalk font-bold'
            : 'text-chalkdim hover:text-chalk hover:bg-overlay/5'
        }`}
      >
        {it.label}
      </a>
    ))}
  </nav>
</div>

---
import { COMPETITIONS } from '../competitions';
import type { Section } from '../utils/router';

interface Props {
  comp: string;
  active?: Section; // omitted on team/player/match pages → nothing highlighted
}
const { comp, active } = Astro.props;
const caps = COMPETITIONS[comp]?.capabilities;

const items: { section: Section; label: string; href: string }[] = [
  { section: 'news', label: 'News', href: `/${comp}/news` },
  { section: 'matches', label: 'Matches', href: `/${comp}` },
  { section: 'teams', label: 'Teams', href: `/${comp}/teams` },
  ...(caps?.scorers
    ? [{ section: 'scorers' as Section, label: 'Stats', href: `/${comp}/scorers` }]
    : []),
  ...(caps?.bracket
    ? [{ section: 'bracket' as Section, label: 'Bracket', href: `/${comp}/bracket` }]
    : []),
  ...(caps?.transactions
    ? [{ section: 'transactions' as Section, label: 'Moves', href: `/${comp}/transactions` }]
    : []),
  ...(caps?.odds ? [{ section: 'odds' as Section, label: 'Odds', href: `/${comp}/odds` }] : []),
];
---
<div class="flex flex-col gap-4 lg:sticky lg:top-[var(--h-topbar)]">
  <nav
    aria-label="Sections"
    class="flex gap-1 overflow-x-auto no-scrollbar lg:flex-col lg:overflow-visible"
  >
    {items.map((it) => (
      <a
        href={it.href}
        aria-current={active === it.section ? 'page' : undefined}
        class={`shrink-0 whitespace-nowrap rounded-card px-3 py-2 font-display text-sm tracking-wide transition-colors ${
          active === it.section
            ? 'bg-overlay/10 text-chalk font-bold'
            : 'text-chalkdim hover:text-chalk hover:bg-overlay/5'
        }`}
      >
        {it.label}
      </a>
    ))}
  </nav>
</div>

---
// Brand wordmark — plain "umuo" text, the trailing "o" in pitch green.
interface Props {
  /** Compact inline variant (footer): smaller, dimmed, no link. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
{compact ? (
  <span class="font-display font-bold tracking-display text-chalkdim">umu<span class="text-pitch">o</span></span>
) : (
  <a href="/" aria-label="umuo home" class="shrink-0 font-display text-xl font-bold tracking-display text-chalk">umu<span class="text-pitch">o</span></a>
)}

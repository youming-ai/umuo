---
import { COMPETITIONS, DEFAULT_COMPETITION } from '../competitions';
import { NEWS_NAV } from '../newsFeed';
import { pathFor } from '../utils/router';

const path = Astro.url.pathname;

const scoreLinks = Object.values(COMPETITIONS).map((comp) => ({
  href: `/${comp.key}`,
  label: comp.label,
}));
---
<div class="space-y-3 lg:sticky lg:top-32">
  <nav aria-label="News quick links" class="ds-glass p-card">
    <h2 class="ds-caption uppercase tracking-[0.2em] text-chalkdim mb-3">Quick Links</h2>
    <div class="flex gap-1 overflow-x-auto no-scrollbar lg:flex-col lg:overflow-visible">
      {NEWS_NAV.map((item) => {
        const href = pathFor({ kind: 'news', comp: DEFAULT_COMPETITION, scope: item.scope });
        const active = href === path;
        return (
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class={`shrink-0 whitespace-nowrap rounded-card px-3 py-2 font-display text-sm tracking-wide transition-colors ${
              active
                ? 'bg-overlay/10 text-chalk font-bold'
                : 'text-chalkdim hover:text-chalk hover:bg-overlay/5'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>

  <nav aria-label="Scoreboard links" class="hidden lg:block ds-glass p-card">
    <h2 class="ds-caption uppercase tracking-[0.2em] text-chalkdim mb-3">Scores</h2>
    <div class="flex flex-col gap-1">
      {scoreLinks.map((item) => (
        <a
          href={item.href}
          class="rounded-card px-3 py-2 font-display text-sm tracking-wide text-chalkdim hover:text-chalk hover:bg-overlay/5 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</div>

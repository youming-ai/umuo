---
import { COMPETITIONS } from '../competitions';
import ThemeToggle from './ThemeToggle';

interface Props {
  comp?: string; // accepted from Layout; nav derives active state from the URL
}
const path = Astro.url.pathname;
const onNews = path === '/news' || path.startsWith('/news/');
const currentComp = Object.keys(COMPETITIONS).find(
  (key) => path === `/${key}` || path.startsWith(`/${key}/`),
);
const onScores = !onNews && !!currentComp;

// One nav bar: News (All) + curated news categories + Scores menu. The Scores
// <details> is the primary path into each competition scoreboard (World Cup /
// Premier League / NBA) after the old competition switcher was removed.
const NEWS_NAV = [
  { href: '/news', label: 'News', active: path === '/news' },
  { href: '/news/soccer', label: 'Soccer', active: path === '/news/soccer' },
  { href: '/news/basketball', label: 'Basketball', active: path === '/news/basketball' },
  { href: '/news/league/eng.1', label: 'EPL', active: path === '/news/league/eng.1' },
  { href: '/news/league/nba', label: 'NBA', active: path === '/news/league/nba' },
];

const scoreComps = Object.values(COMPETITIONS);
---
<header class="border-b border-line/30 bg-panel/85 backdrop-blur-md">
  <div class="flex items-center gap-4 px-page-x md:px-page-x-md h-14">
    <a href="/news" class="font-display font-bold text-lg tracking-wide text-chalk shrink-0">
      umu<span class="text-pitch">o</span>
    </a>

    <nav aria-label="Main" class="ds-segmented-blur overflow-x-auto no-scrollbar">
      {NEWS_NAV.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`whitespace-nowrap ds-seg-tab ${item.active ? 'ds-seg-tab-active' : 'ds-seg-tab-inactive'}`}
        >
          {item.label}
        </a>
      ))}

      <details class="relative">
        <summary
          class={`whitespace-nowrap ds-seg-tab list-none cursor-pointer [&::-webkit-details-marker]:hidden ${
            onScores ? 'ds-seg-tab-active' : 'ds-seg-tab-inactive'
          }`}
          aria-current={onScores ? 'true' : undefined}
        >
          Scores
        </summary>
        <div
          class="absolute top-full left-0 z-50 mt-1 min-w-[11rem] rounded-card border border-line/30 bg-panel/95 p-1 shadow-lg backdrop-blur-md"
          role="menu"
          aria-label="Competition scores"
        >
          {scoreComps.map((c) => (
            <a
              href={`/${c.key}`}
              role="menuitem"
              aria-current={currentComp === c.key ? 'page' : undefined}
              class={`block whitespace-nowrap rounded-card px-3 py-2 font-display text-sm transition-colors ${
                currentComp === c.key
                  ? 'bg-overlay/10 font-bold text-chalk'
                  : 'text-chalkdim hover:bg-overlay/5 hover:text-chalk'
              }`}
            >
              {c.label}
            </a>
          ))}
        </div>
      </details>
    </nav>

    <div class="ml-auto shrink-0">
      <ThemeToggle client:only="react" />
    </div>
  </div>
</header>

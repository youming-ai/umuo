---
import { COMPETITIONS } from '../competitions';
import ThemeToggle from './ThemeToggle';

// ESPN-style hierarchical top navigation:
// Home · Football ▾ (Soccer Leagues) · NBA · Odds
const path = Astro.url.pathname;
const currentComp = Object.keys(COMPETITIONS).find(
  (key) => path === `/${key}` || path.startsWith(`/${key}/`),
);

const isHome = path === '/';
const soccerComps = Object.values(COMPETITIONS).filter((c) => c.sport === 'soccer');
const basketballComps = Object.values(COMPETITIONS).filter((c) => c.sport === 'basketball');

const isSoccerActive = !!currentComp && COMPETITIONS[currentComp]?.sport === 'soccer';
const activeSoccerLabel = isSoccerActive ? COMPETITIONS[currentComp]?.label : 'Football';

const tab =
  'relative flex shrink-0 items-center whitespace-nowrap px-3 font-display text-sm tracking-wide ds-press';
const on = 'font-semibold text-chalk';
const off = 'text-chalkdim hover:text-chalk';
---
<header class="border-b border-line/30 bg-panel/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center gap-6 px-page-x md:px-page-x-md">
    <a href="/" class="shrink-0 font-display text-lg font-bold tracking-wide text-chalk">
      umu<span class="text-pitch">o</span>
    </a>

    <nav
      aria-label="Primary"
      class="flex h-full min-w-0 flex-1 items-stretch gap-1 overflow-x-auto no-scrollbar"
    >
      <a href="/" aria-current={isHome ? 'page' : undefined} class={`${tab} ${isHome ? on : off}`}>
        Home
        {isHome && (
          <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-pitch" aria-hidden="true"></span>
        )}
      </a>

      <!-- Football (Soccer) Hierarchical Dropdown -->
      <details class="relative flex shrink-0 items-stretch">
        <summary class={`${tab} cursor-pointer list-none ${isSoccerActive ? on : off}`}>
          <span>{isSoccerActive ? activeSoccerLabel : 'Football'}</span>
          <span class="ml-1 text-[0.6rem]" aria-hidden="true">▾</span>
          {isSoccerActive && (
            <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-pitch" aria-hidden="true"></span>
          )}
        </summary>
        <div class="absolute left-0 top-full z-50 mt-1 flex min-w-48 flex-col gap-1 rounded-card border border-line bg-panel p-1.5 shadow-panel">
          <div class="px-3 py-1 text-micro font-mono uppercase tracking-widest text-chalkdim border-b border-line/30 mb-1">
            Soccer Leagues
          </div>
          {soccerComps.map((c) => (
            <a
              href={`/${c.key}`}
              aria-current={currentComp === c.key ? 'page' : undefined}
              class={`rounded-card px-3 py-2 font-display text-sm tracking-wide ds-press flex items-center justify-between ${
                currentComp === c.key
                  ? 'bg-overlay/10 font-semibold text-chalk'
                  : 'text-chalkdim hover:bg-overlay/5 hover:text-chalk'
              }`}
            >
              <span>{c.label}</span>
              {currentComp === c.key && <span class="h-1.5 w-1.5 rounded-full bg-pitch"></span>}
            </a>
          ))}
        </div>
      </details>

      <!-- Basketball (NBA) -->
      {basketballComps.map((c) => (
        <a
          href={`/${c.key}`}
          aria-current={currentComp === c.key ? 'page' : undefined}
          class={`${tab} ${currentComp === c.key ? on : off}`}
        >
          {c.label}
          {currentComp === c.key && (
            <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-pitch" aria-hidden="true"></span>
          )}
        </a>
      ))}

      <!-- Odds -->
      <a
        href="/eng.1/odds"
        aria-current={path.includes('/odds') ? 'page' : undefined}
        class={`${tab} ${path.includes('/odds') ? on : off}`}
      >
        Odds
        {path.includes('/odds') && (
          <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-pitch" aria-hidden="true"></span>
        )}
      </a>
    </nav>

    <div class="shrink-0">
      <ThemeToggle client:only="react" />
    </div>
  </div>
</header>

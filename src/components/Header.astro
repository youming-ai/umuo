---
import { COMPETITIONS, DEFAULT_COMPETITION } from '../competitions';
import { SECTIONS } from '../sections';
import { pathFor } from '../utils/router';
import ActiveIndicator from './ActiveIndicator.astro';
import ThemeSwitcher from './ThemeSwitcher';

// ESPN-style two-tier navigation: a top sport bar where each sport tab opens a
// mega-dropdown of that sport's leagues + sections. Everything is derived from
// COMPETITIONS + SECTIONS so no dropdown link ever outruns a real page.
//   Home · Football ▾ (leagues × sections) · NBA ▾ (sections) · Odds
//
// <details>/<summary> is load-bearing, not decoration: one native disclosure
// gives click, touch, Enter/Space, and a real role to AT. A hover-only <div>
// left every league and section link unreachable by keyboard and absent from
// the accessibility tree.
const path = Astro.url.pathname;
const currentComp = Object.keys(COMPETITIONS).find(
  (key) => path === `/${key}` || path.startsWith(`/${key}/`),
);

const isHome = path === '/';
const soccerComps = Object.values(COMPETITIONS).filter((c) => c.sport === 'soccer');
const basketballComps = Object.values(COMPETITIONS).filter((c) => c.sport === 'basketball');

const isSoccerActive = !!currentComp && COMPETITIONS[currentComp]?.sport === 'soccer';
const isBasketballActive = !!currentComp && COMPETITIONS[currentComp]?.sport === 'basketball';

// Section links for a competition, gated by capability — same derivation as
// LeftNav so the dropdown never drifts from the per-comp section nav.
function sectionItems(comp: string) {
  const caps = COMPETITIONS[comp]?.capabilities;
  return SECTIONS.filter((s) => !s.capability || caps?.[s.capability]).map((s) => ({
    label: s.label,
    href: pathFor({ kind: 'section', comp, section: s.section }),
  }));
}

// Football dropdown surfaces sections for the active soccer league, else the
// default one — so the sections column always maps to a concrete league.
const soccerNavComp = isSoccerActive && currentComp ? currentComp : DEFAULT_COMPETITION;
const soccerNavLabel = COMPETITIONS[soccerNavComp]?.label ?? 'Premier League';
const soccerSections = sectionItems(soccerNavComp);

const nbaComp = basketballComps[0]?.key ?? 'nba';
const nbaLabel = COMPETITIONS[nbaComp]?.label ?? 'NBA';
const nbaSections = sectionItems(nbaComp);

// Odds is a per-competition section; surface the default competition's odds page
// in the global nav so the link stays in sync with src/sections.ts.
const oddsPath = pathFor({ kind: 'section', comp: DEFAULT_COMPETITION, section: 'odds' });
const isOddsActive = path === oddsPath;

const tab =
  'relative flex shrink-0 items-center whitespace-nowrap px-3 font-display text-sm tracking-wide ds-press';
const on = 'font-semibold text-chalk';
const off = 'text-chalkdim hover:text-chalk';
const caret = 'ml-1 text-[0.6rem] transition-transform group-open:rotate-180';
const menuHead =
  'px-3 py-1 text-micro font-mono uppercase tracking-widest text-chalkdim border-b border-line/30 mb-1';
const menuLink =
  'rounded-card px-3 py-2 font-display text-sm tracking-wide ds-press flex items-center justify-between';
const menuOn = 'bg-overlay/10 font-semibold text-chalk';
const menuOff = 'text-chalkdim hover:bg-overlay/5 hover:text-chalk';
---
<header class="border-b border-line/30 bg-panel/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center gap-6 px-page-x md:px-page-x-md">
    <a href="/" class="shrink-0 font-display text-lg font-bold tracking-wide text-chalk">
      umu<span class="text-pitch">o</span>
    </a>

    <nav
      aria-label="Primary"
      class="flex h-full min-w-0 flex-1 items-stretch gap-1 overflow-visible"
    >
      <a href="/" aria-current={isHome ? 'page' : undefined} class={`${tab} ${isHome ? on : off}`}>
        Home
        {isHome && <ActiveIndicator />}
      </a>

      <!-- Football (Soccer) mega-dropdown: leagues × active-league sections -->
      <details class="group relative flex shrink-0 items-stretch">
        <summary
          class={`${tab} cursor-pointer list-none [&::-webkit-details-marker]:hidden ${isSoccerActive ? on : off}`}
        >
          <span>Football</span>
          <span class={caret} aria-hidden="true">▾</span>
          {isSoccerActive && <ActiveIndicator />}
        </summary>
        {/* Click-driven only. A display:none menu is not hit-testable, so a
            hover-opened menu cannot be reached: :hover drops the instant the
            pointer leaves the summary box and the menu vanishes before the
            pointer arrives. Verified broken both with and without a gap — so
            hover is gone rather than faked. <details> already covers mouse,
            touch, keyboard and AT with one mechanism. */}
        <div class="absolute left-0 top-full z-50 hidden group-open:block">
          <div class="grid min-w-[28rem] grid-cols-2 gap-3 rounded-card border border-line bg-panel p-2 shadow-panel">
            <div class="flex flex-col gap-1">
              <div class={menuHead}>Leagues</div>
              {
                soccerComps.map((c) => (
                  <a
                    href={`/${c.key}`}
                    aria-current={currentComp === c.key ? 'page' : undefined}
                    class={`${menuLink} ${currentComp === c.key ? menuOn : menuOff}`}
                  >
                    <span>{c.label}</span>
                    {currentComp === c.key && <span class="h-1.5 w-1.5 rounded-full bg-pitch" />}
                  </a>
                ))
              }
            </div>
            <div class="flex flex-col gap-1">
              <div class={menuHead}>{soccerNavLabel}</div>
              {
                soccerSections.map((it) => (
                  <a
                    href={it.href}
                    aria-current={path === it.href ? 'page' : undefined}
                    class={`${menuLink} ${path === it.href ? menuOn : menuOff}`}
                  >
                    <span>{it.label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </details>

      <!-- Basketball (NBA) dropdown: single-column section menu -->
      <details class="group relative flex shrink-0 items-stretch">
        <summary
          class={`${tab} cursor-pointer list-none [&::-webkit-details-marker]:hidden ${isBasketballActive ? on : off}`}
        >
          <span>{nbaLabel}</span>
          <span class={caret} aria-hidden="true">▾</span>
          {isBasketballActive && <ActiveIndicator />}
        </summary>
        <div class="absolute left-0 top-full z-50 hidden group-open:block">
          <div class="flex min-w-48 flex-col gap-1 rounded-card border border-line bg-panel p-2 shadow-panel">
            <div class={menuHead}>{nbaLabel}</div>
            {
              nbaSections.map((it) => (
                <a
                  href={it.href}
                  aria-current={path === it.href ? 'page' : undefined}
                  class={`${menuLink} ${path === it.href ? menuOn : menuOff}`}
                >
                  <span>{it.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Odds -->
      <a
        href={oddsPath}
        aria-current={isOddsActive ? 'page' : undefined}
        class={`${tab} ${isOddsActive ? on : off}`}
      >
        Odds
        {isOddsActive && <ActiveIndicator />}
      </a>
    </nav>

    <div class="shrink-0">
      <ThemeSwitcher client:only="react" />
    </div>
  </div>
</header>

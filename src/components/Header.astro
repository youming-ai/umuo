---
import { COMPETITIONS, DEFAULT_COMPETITION } from '../competitions';
import ThemeToggle from './ThemeToggle';

interface Props {
  comp?: string; // accepted from Layout; nav derives active state from the URL
}
const path = Astro.url.pathname;
const onNews = path === '/news' || path.startsWith('/news/');
const onScores =
  !onNews &&
  Object.keys(COMPETITIONS).some((key) => path === `/${key}` || path.startsWith(`/${key}/`));

// Two-level nav: the header switches top-level areas (News ↔ Scores). News
// categories live in the NewsView strip; comp switching lives in Scores views.
const NAV = [
  { href: '/news', label: 'News', active: onNews },
  { href: `/${DEFAULT_COMPETITION}`, label: 'Scores', active: onScores },
];
---
<header class="border-b border-line/30 bg-panel/85 backdrop-blur-md">
  <div class="flex items-center gap-4 px-page-x md:px-page-x-md h-14">
    <a href="/news" class="font-display font-bold text-lg tracking-wide text-chalk shrink-0">
      Stream<span class="text-pitch">Cup</span>
    </a>

    <nav aria-label="Main" class="ds-segmented-blur overflow-x-auto no-scrollbar">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`whitespace-nowrap ds-seg-tab ${item.active ? 'ds-seg-tab-active' : 'ds-seg-tab-inactive'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto shrink-0">
      <ThemeToggle client:only="react" />
    </div>
  </div>
</header>

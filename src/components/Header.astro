---
import ThemeToggle from './ThemeToggle';

// Minimal top bar: brand + theme toggle. Competition/section switching lives in
// the left rail (LeftNav / HomeNav), not here — the header no longer carries a
// competition switcher.
---
<header class="border-b border-line/30 bg-panel/85 backdrop-blur-md">
  <div class="flex items-center gap-4 mx-auto w-full max-w-6xl px-page-x md:px-page-x-md h-14">
    <a href="/" class="font-display font-bold text-lg tracking-wide text-chalk shrink-0">
      umu<span class="text-pitch">o</span>
    </a>
    <div class="min-w-0 flex-1"></div>
    <div class="shrink-0">
      <ThemeToggle client:only="react" />
    </div>
  </div>
</header>

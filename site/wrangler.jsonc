// umuo.app —— 官网静态产物 + /api/* 与 /download/* 的 Worker。
//
// 为什么配置在**仓库根**而不是 worker/ 下：Cloudflare Workers Builds 里那个 `umuo`
// 服务的 root directory 就是仓库根（它之前托管的是同账号的另一个项目）。配置放错
// 位置的表现是「构建直接失败，日志只在 dashboard 里」，本地怎么看都是好的。
//
// 这里出现的都不是密钥：绑定的 id 是资源标识而不是凭据。真要放密钥用
// `wrangler secret put`，不进这个文件、也不进 git。
// 线上另有一个 secret：WAFFO_PRIVATE_KEY（收费要用）。
//
// 用 JSONC 而不是 TOML：Void 只认 wrangler.jsonc（迁移方案 PR 2）。
// 下面的 routes / workers_dev / preview_urls / observability 照抄控制台的现状写成显式配置，
// 不再依赖 wrangler 的默认值与控制台碰巧一致（preview_urls 的默认值就是 false，与线上不同）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umuo-app",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-07-17",
  // Waffo 的官方 SDK（@waffo/pancake-ts）用 node:crypto 的 createSign / createVerify 签名与验签；
  // 已在本地 workerd 实测可用。去掉这个 flag，收费接口会在加载时就失败。
  "compatibility_flags": ["nodejs_compat"],

  // 只有 umuo.app 一个自定义域名（没有 www）。
  "routes": [{ "pattern": "umuo.app", "custom_domain": true }],
  // 仅保留 umuo.app；额外公开入口不经过该域名的 zone 规则。
  "workers_dev": false,
  "preview_urls": false,

  // `/`、`/pricing`、`/terms`、`/privacy`、语言前缀的旧地址、/api/* 与 /download/* 先交给 Worker，其余路径由静态资源层直接返回。
  // 地址里不放语言：`/` 与 `/pricing`、`/terms`、`/privacy` 由 Worker 按 cookie / 浏览器语言挑一份预渲染页（经 ASSETS 绑定读取）。
  // 官网是**预渲染的多页站**（vite build + renderToString 注入），不是 SPA，
  // 所以不做 index.html 兜底：未知路径就该 404，而不是回一个首页副本。
  // 资源目录由根脚本 `bun run build:web` 生成（`bun run build` 就是它）。
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/pricing",
      "/pricing/",
      "/terms",
      "/terms/",
      "/privacy",
      "/privacy/",
      "/activate",
      "/activate/",
      "/zh-cn",
      "/zh-cn/*",
      "/zh-tw",
      "/zh-tw/*",
      "/en",
      "/en/*",
      "/ja",
      "/ja/*",
      "/ko",
      "/ko/*",
      "/api/*",
      "/download/*"
    ]
  },

  "kv_namespaces": [
    // 上线通知的邮箱列表。namespace 名 `umuo-notify`，与 9.6 的账号服务无关 ——
    // 官网这一份只是「发布时通知你」，不做账号系统（账号服务不在此仓库）。
    { "binding": "NOTIFY_KV", "id": "dad4b460f4a14797adc1e9491e42f7f1" },
    // Premium 许可证、结账领取码与 webhook 去重（worker/src/billing.ts）。
    { "binding": "LICENSES", "id": "9afc88feb77741739cbdb9929343e487" }
  ],

  // 客户端安装包。仓库根目录的 Release 工作流每次合进 main 都往这里传新的 .dmg，
  // 并更新 macos/latest.json；Worker 只读。
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "umuo-releases" }],

  // Waffo Pancake 收费配置。这里只放不敏感的 ID；私钥用 `wrangler secret put WAFFO_PRIVATE_KEY`，
  // 绝不进这个文件、也不进 git。任何一项缺失，收费接口都回 503（见 billing.ts 的 waffoConfig）。
  // WAFFO_ENV 是正式环境（prod）：正式收款还要等 Waffo 的店铺审核通过；在那之前 checkout 会被拒，
  // 而定价页也还没有购买入口，访客碰不到。两个商品 ID 由 scripts/waffo-setup.ts 建好后写回这里
  // （脚本按「一行一个 "NAME": "值"」改写，别把这几项挤到同一行）。
  "vars": {
    "WAFFO_ENV": "prod",
    "WAFFO_MERCHANT_ID": "MER_REDACTED",
    "WAFFO_STORE_ID": "STO_REDACTED",
    "WAFFO_PRODUCT_PREMIUM_MONTHLY": "PROD_REDACTED_MONTHLY",
    "WAFFO_PRODUCT_PREMIUM_YEARLY": "PROD_REDACTED_YEARLY"
  },

  // PR 预览（`wrangler preview`）用的绑定。
  "previews": {
    "kv_namespaces": [
      // `umuo-notify-preview`：预览里提交的测试邮箱不会混进正式名单，预览也读不到真实名单。
      { "binding": "NOTIFY_KV", "id": "269178fa91564fc6954a8fd1b33d3be7" },
      // 预览用独立 namespace：PR 预览里测出来的许可证不会混进正式数据。
      { "binding": "LICENSES", "id": "5197702966104e0a834192959fad8a25" }
    ],
    // PR 预览绑独立的空桶：R2 绑定本身不限制写入，预览里的代码不该碰得到正式安装包。
    // 预览环境的下载因此是 503「正在准备中」，这是预期的。
    "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "umuo-releases-preview" }]
  },

  // 调用日志默认只记 URL 与状态码；邮箱在 POST body 里，不会进 URL，所以不会落进日志。
  // 与控制台一致：日志开、持久化、记调用日志；traces 关。
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}

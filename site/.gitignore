# 依赖
node_modules/

# 构建产物
dist/
# 官网预渲染用的服务端 bundle（构建末尾会删除，失败时可能残留）
dist-ssr/
*.tsbuildinfo

# Cloudflare 本地运行的状态目录（umuo.app 的 Worker 见 docs/DEPLOY.md）
.wrangler/

# 环境变量（Worker 目前不需要任何 secret；本地若有 .env 也不进 git）
.env
.env.local
.env.*.local

# 测试
coverage/

# 日志
*.log

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store

# 其它包管理器（本仓库用 Bun，bun.lock 要提交）
package-lock.json
yarn.lock
pnpm-lock.yaml

# Void 的生成物（根目录 vite build / void 命令产出，见 vite.config.ts）
.void/
.void-wrangler.jsonc

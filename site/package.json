{
  "name": "umuo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "umuo.app 官网与官网 API（Cloudflare Worker）",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter umuo-web dev",
    "dev:web": "bun run --filter umuo-web dev",
    "dev:worker": "vite --host 127.0.0.1",
    "build": "bun run build:web && VOID_CLOUDFLARE_DEPLOY_BUILD=1 vite build && bun scripts/check-void-build.ts && node scripts/check-void-ready.mjs",
    "build:web": "bun run --filter umuo-web build",
    "deploy": "bun run build && bun scripts/cf-deploy.ts",
    "lint": "biome check .",
    "format": "biome format . --write",
    "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json && bun run --filter umuo-web type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "bun run lint && bun run type-check && bun run test:run && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "cf": "1.0.0-beta.18",
    "happy-dom": "^20.14.6",
    "miniflare": "5.20261012.1-beta",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "void": "1.2.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}

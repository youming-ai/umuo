{
  "name": "umuo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "umuo — macOS 系统级 AI 翻译客户端（闭源）",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter umuo-desktop dev",
    "dev:desktop": "bun run --filter umuo-desktop dev",
    "build": "bun run build:desktop",
    "build:desktop-ui": "bun run --filter umuo-desktop build:vite",
    "build:desktop": "bun run --filter umuo-desktop build",
    "icons": "bun run scripts/make-icons.ts",
    "lint": "biome check .",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all -- --check",
    "format": "biome format . --write",
    "type-check": "tsc --noEmit && bun run --filter umuo-desktop type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rust": "cargo test --workspace",
    "verify": "bun run lint && bun run type-check && bun run test:run && bun run fmt:rust && bun run clippy && bun run test:rust && bun run build:desktop-ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

{
  "name": "umuo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "umuo — macOS 系统级 AI 翻译客户端（闭源）",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run dev:macos",
    "dev:macos": "sh apps/macos/scripts/dev.sh",
    "build": "sh apps/macos/scripts/build.sh",
    "icons": "bun run scripts/make-icons.ts",
    "lint": "biome check .",
    "format": "biome format . --write",
    "type-check": "tsc --noEmit",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all -- --check",
    "test:rust": "cargo test --workspace",
    "verify:macos": "sh apps/macos/scripts/verify.sh",
    "bundle:macos": "sh apps/macos/scripts/bundle.sh",
    "release:swift": "sh scripts/release-swift-local.sh",
    "verify": "bun run lint && bun run type-check && bun run test:tools && bun run fmt:rust && bun run clippy && bun run test:rust && bun run verify:macos",
    "test:tools": "bun test scripts/sparkle-appcast.test.ts scripts/asr-fixtures.test.ts scripts/asr-eval.test.ts",
    "asr:fixtures": "bun run scripts/asr-fixtures.ts",
    "asr:eval": "bun run scripts/asr-eval.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}

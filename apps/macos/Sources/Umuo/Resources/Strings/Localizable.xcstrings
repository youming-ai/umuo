        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的麥克風，或輸入裝置在錄音途中發生了變化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone is available, or the input device changed during recording."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用できるマイクがないか、録音中に入力デバイスが変わりました。"

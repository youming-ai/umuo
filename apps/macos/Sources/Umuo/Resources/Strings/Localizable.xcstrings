          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來讀取你選取的文字。沒有它，劃詞翻譯無法運作——這是唯一一項「必需」的權限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to read the text you select. Without it, selection translation cannot work — the only \"required\" permission."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを読むために使います。これが無いと選択翻訳は動作しません——唯一の「必須」権限です。"

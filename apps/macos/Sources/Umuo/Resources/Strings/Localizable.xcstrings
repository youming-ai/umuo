    "onboarding.localMissing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没检测到 Ollama 或 LM Studio。确认其中一个已启动（ollama serve，或在 LM Studio 里打开本地服务）再试一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒檢測到 Ollama 或 LM Studio。確認其中一個已啟動（ollama serve，或在 LM Studio 裡打開本機服務）再試一次"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find Ollama or LM Studio. Make sure one of them is running (ollama serve, or start the local server in LM Studio) and try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama も LM Studio も見つかりません。どちらかが起動していること（ollama serve、または LM Studio のローカルサーバー）を確認してもう一度お試しください"
          }
        }
      }
    },

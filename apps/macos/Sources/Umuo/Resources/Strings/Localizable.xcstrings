    "history.privacyNotice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私模式已开启：这期间的翻译不会写入历史。要记录就先到「设置 → 数据」关掉它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私模式已開啟：這期間的翻譯不會寫入歷史。要記錄請先到「設定 → 資料」關掉它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy mode is on: translations are not written to history. Turn it off under Settings → Data to record them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーモードが有効です：この間の翻訳は履歴に書き込まれません。記録するには「設定 → データ」で解除してください。"
          }
        }
      }
    },

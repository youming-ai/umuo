    "compose.pasteNotBack": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "译文已复制到剪贴板，但原来的应用没能回到前台，没有自动粘贴。可以手动 ⌘V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "譯文已複製到剪貼簿，但原本的應用程式沒能回到前景，沒有自動貼上。可以手動按 ⌘V。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation is on the clipboard, but the original app didn't come back to the front, so it wasn't pasted. Press ⌘V to paste it yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訳文をクリップボードにコピーしましたが、元のアプリが前面に戻らなかったため貼り付けていません。⌘V で貼り付けてください。"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "核心啟動失敗：%1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine failed to start: %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンを起動できませんでした：%1$@"
          }
        }
      },
      "comment": "placeholders: reason"
    },

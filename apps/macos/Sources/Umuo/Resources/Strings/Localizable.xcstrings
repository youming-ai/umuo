    "prefs.glossary.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译前只把文中出现的术语带给模型，所以表再大也不会让每次请求变贵。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯前只把文中出現的詞彙帶給模型，所以表再大也不會讓每次請求變貴。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only terms that appear in the text are sent to the model, so a large glossary doesn’t make requests more expensive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文中に出てくる用語だけをモデルに渡すので、用語集が大きくても毎回の費用は増えません。"
          }
        }
      }

    "prefs.translate.blacklistHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个应用名。在这些应用里 umuo 不会读取你选中的文字，默认包含常见的密码管理器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個應用程式名稱。在這些應用程式裡 umuo 不會讀取你選取的文字，預設包含常見的密碼管理器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One app name per line. umuo never reads selected text in these apps. Common password managers are included by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 つのアプリ名。これらのアプリでは選択した文字を読み取りません。主なパスワード管理アプリは最初から入っています。"
          }
        }
      }
    },

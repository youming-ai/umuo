    "prefs.translate.ocrEngineHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 macOS 自带的文字识别，截图不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 macOS 內建的文字辨識，截圖不會上傳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the text recognition built into macOS. Screenshots never leave your Mac."
          }
        },
        "ja": {

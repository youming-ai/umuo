    "onboarding.modelLead": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填一把自己的 API Key 就能用。Key 存进系统 Keychain，只参与请求头，不写进配置文件、不进日志、也不会传给界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填一把自己的 API Key 就能用。Key 存進系統 Keychain，只參與請求標頭，不寫進設定檔、不進日誌、也不會傳給介面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste one of your own API keys and it works. The key is stored in the system Keychain and is only used in request headers — never in config files, logs, or the interface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の API キーを貼れば使えます。キーはシステムの Keychain に保存され、リクエストヘッダーにのみ使われます——設定ファイル・ログ・画面には決して現れません。"
          }
        }
      }
    },

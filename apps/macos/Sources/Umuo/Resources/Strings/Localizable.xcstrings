    "voice.error.micDenied": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请在「系统设置 → 隐私与安全性 → 麦克风」里允许 umuo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有麥克風權限。請在「系統設定 → 隱私權與安全性 → 麥克風」中允許 umuo。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo doesn't have microphone access. Allow it in System Settings → Privacy & Security → Microphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが許可されていません。「システム設定 → プライバシーとセキュリティ → マイク」で umuo を許可してください。"
          }
        }
      }
    },
    "voice.error.model": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音模型无法加载。请再试一次；仍然失败的话，模型文件可能已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音模型無法載入。請再試一次；仍然失敗的話，模型檔案可能已損壞。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice model couldn't be loaded. Try again; if it keeps failing, the model file may be damaged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルを読み込めませんでした。もう一度お試しください。繰り返し失敗する場合はモデルファイルが破損している可能性があります。"
          }
        }
      }
    },
    "voice.error.noDevice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的麦克风，或输入设备在录音中途发生了变化。"

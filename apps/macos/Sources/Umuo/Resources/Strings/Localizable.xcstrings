    "voice.micUsage": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 需要使用麦克风，录下你按住语音快捷键时说的话，并在本机转写成文字。录音只用于当次，结束后即删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 需要使用麥克風，錄下你按住語音快捷鍵時說的話，並在本機轉寫成文字。錄音只用於當次，結束後即刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo uses the microphone to record what you say while holding the voice shortcut and transcribes it on this Mac. Recordings are used only for that session and deleted afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo は、音声ショートカットを押している間の発話を録音し、この Mac 上で文字に変換するためにマイクを使用します。録音はその回だけに使い、終了後に削除します。"
          }
        }
      }
    },

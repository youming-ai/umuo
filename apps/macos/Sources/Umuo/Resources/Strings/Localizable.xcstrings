    "prefs.about.checkUpdatesHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时会自动检查并在后台装好新版，菜单栏图标里出现「重启以更新」时点一下即可；也可以从那里手动检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動時會自動檢查並在背景裝好新版，之後在選單列圖示的選單裡點一下重新啟動即可；也可以從那裡手動檢查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo checks for updates at launch and installs them in the background; restart from the menu bar icon’s menu to finish. You can also check by hand from that menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動時に自動で確認し、新しい版をバックグラウンドで入れておきます。メニューバーのアイコンのメニューから再起動すると完了します。そこから手動でも確認できます。"
          }
        }
      }
    },
    "prefs.about.checkUpdatesPending": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一版还没有应用内更新（随正式发布提供），现在请到官网下载新版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一版還沒有應用程式內更新（隨正式發佈提供），現在請到官網下載新版。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app updates are not available in this build yet (they ship with the release). For now, download new versions from the website."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはまだアプリ内アップデートがありません（正式リリースで提供）。新しい版は公式サイトからダウンロードしてください。"
          }
        }
      }
    },

    "app.noHome": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到用户主目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到使用者主目錄"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home folder could not be found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダが見つかりません"
          }
        }
      }
    },
    "autostart.devBuild": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发构建（不是打包好的 umuo.app）不能开启开机启动：登录项会指向这个临时程序"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發版本（不是封裝好的 umuo.app）不能開啟開機啟動：登入項目會指向這個暫時的程式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development builds (not a packaged umuo.app) can't launch at login: the login item would point at this temporary binary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ビルド（パッケージ済みの umuo.app ではない）ではログイン時に起動をオンにできません：ログイン項目がこの一時的なプログラムを指してしまいます"
          }
        }
      }
    },
    "autostart.temporaryLocation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 正从临时位置运行（磁盘映像或系统隔离目录）。请先把它拖进「应用程序」文件夹、从那里打开，再开启开机启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 正從暫時位置執行（磁碟映像檔或系統隔離目錄）。請先把它拖進「應用程式」檔案夾、從那裡打開，再開啟開機啟動"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo is running from a temporary location (a disk image or a translocated folder). Move it to the Applications folder and open it from there, then turn on Launch at login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo が一時的な場所（ディスクイメージやシステムの隔離フォルダ）から実行されています。「アプリケーション」フォルダに移動してそこから開いてから、ログイン時に起動をオンにしてください"
          }
        }
      }
    },

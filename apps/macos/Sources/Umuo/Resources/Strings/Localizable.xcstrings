          "stringUnit": {
            "state": "translated",
            "value": "结果没有说完（可能触到输出上限），可以复制或重试，不会自动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果沒有說完（可能觸到輸出上限），可以複製或重試，不會自動輸入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result was cut off (it may have hit the output limit). You can copy it or retry; it won’t be typed in automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が途中で切れています（出力上限に達した可能性があります）。コピーまたは再試行できます。自動では入力しません。"
          }
        }
      }
    },

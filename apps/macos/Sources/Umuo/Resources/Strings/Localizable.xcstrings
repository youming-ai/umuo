    "prefs.translate.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用里选中文字，按一下快捷键就能翻译。点一下键位就能重新录，改完立刻生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何應用程式裡選取文字，按一下快捷鍵就能翻譯。點一下鍵位就能重新錄製，改完立刻生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text in any app and press a shortcut to translate it. Click a shortcut to record a new one; changes apply right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも、文字を選んでショートカットを押せば翻訳できます。キーをクリックすると新しいショートカットを設定でき、変更はすぐ反映されます。"
          }
        }
      }
    },

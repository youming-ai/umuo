    "compare.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中一段文字后按 %1$@，同一段内容会同时发给多个模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取一段文字後按 %1$@，同一段內容會同時送給多個模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select some text and press %1$@ — the same text goes to several models at once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを選択して %1$@ を押すと、同じ内容を複数のモデルへ同時に送ります。"
          }
        }
      },
      "comment": "placeholders: keys"
    },

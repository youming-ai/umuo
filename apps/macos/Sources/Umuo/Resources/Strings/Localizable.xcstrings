    "prefs.permissions.screenHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图翻译需要它来读取你框选的屏幕区域。授权后通常要重启 umuo 才显示为已授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖翻譯需要它來讀取你框選的螢幕區域。授權後通常要重新啟動 umuo 才顯示為已授權。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed for screenshot translation to read the area you select. After granting it, umuo usually has to restart before it shows as granted."
          }
        },
        "ja": {

      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开设置窗再试一次；若一直失败，说明客户端与界面之间的通信出了问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟設定視窗再試一次；若一直失敗，表示用戶端與介面之間的通訊出了問題。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the settings window and try again; if it keeps failing, the communication between the app and the interface is broken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ウィンドウを開き直してもう一度お試しください。繰り返し失敗する場合は、アプリと UI の間の通信に問題があります。"
          }
        }

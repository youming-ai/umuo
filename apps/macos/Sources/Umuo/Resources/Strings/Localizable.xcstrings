    "prefs.about.dataLocalHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置与历史存在本机；API Key 只在系统钥匙串里。翻译请求从你的电脑直接发给你配置的厂商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定與歷史存在本機；API Key 只在系統鑰匙圈裡。翻譯請求從你的電腦直接送到你設定的廠商。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings and history stay on this Mac, and API keys live only in the Keychain. Translation requests go straight from your computer to the provider you chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定と履歴はこの Mac に保存され、API キーはキーチェーンにだけあります。翻訳のリクエストはあなたの Mac から設定した提供元へ直接送られます。"
          }
        }
      }
    },

    "onboarding.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 常驻菜单栏。它不替你买模型额度——你用自己的 API Key（BYOK），请求从你的电脑直连厂商，也可以接本机的 Ollama / LM Studio 离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo 常駐選單列。它不替你買模型額度——你用自己的 API Key（BYOK），請求從你的電腦直連廠商，也可以接本機的 Ollama / LM Studio 離線使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo lives in the menu bar. It does not sell you model quota — you bring your own API key (BYOK), requests go from your machine straight to the provider, and you can also use a local Ollama / LM Studio offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "umuo はメニューバーに常駐します。モデルの利用枠は売りません——自分の API キー（BYOK）を使い、リクエストはこの Mac からプロバイダーへ直接。ローカルの Ollama / LM Studio を繋いでオフラインで使うこともできます。"
          }
        }
      }
    },

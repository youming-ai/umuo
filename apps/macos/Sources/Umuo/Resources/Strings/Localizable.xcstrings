    "prefs.translate.compareModelsHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以对比同一家的不同模型。清单为空时，改用下面勾选的供应商。"

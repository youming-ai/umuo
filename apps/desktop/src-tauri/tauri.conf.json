{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "umuo",
  "version": "0.1.0",
  "identifier": "app.umuo.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "系统级 AI 翻译客户端（BYOK）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMkU2M0Q1OTlENUY1NEYKUldSUDlkV1oxV011U2dsdHhCYlIyRkdhL25GSnM4VDE5dVBncmN4d2FMbVpTckpRQ0taenE2dFgK",
      "endpoints": ["https://umuo.app/download/macos/update.json"]
    }
  }
}

# 依赖
node_modules/

# 构建产物
dist/
# 官网预渲染用的服务端 bundle（构建末尾会删除，失败时可能残留）
dist-ssr/
target/
*.tsbuildinfo

# wrangler 的本地状态（历史遗留，可能含测试邮箱，永远不提交）
.wrangler/

# 环境变量（本仓库不需要任何服务端密钥；BYOK 的 key 存在系统凭据存储里）
.env
.env.local
.env.*.local

# 测试
coverage/

# 日志
*.log

# 编辑器 / 系统 / 设计工具审查快照
.vscode/
.idea/
.DS_Store
/.impeccable/

# 其它包管理器（本仓库用 Bun；bun.lock 与 Cargo.lock 都提交）
package-lock.json
yarn.lock
pnpm-lock.yaml
